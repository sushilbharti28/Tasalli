# Copy to .env (never commit it). Names only; values come from the environment.
PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/tasalli_api_dev
REDIS_URL=redis://localhost:6379
# Optional BullMQ key prefix; call-engine must use the same value.
BULLMQ_PREFIX=bull
# Required outside development. HMAC key for session tokens.
SESSION_SECRET=
# OTP: only the fake sender exists (founder rule: no paid services).
OTP_SENDER=fake
# Fixed OTP code accepted by the fake sender (dev/test only, never in production).
OTP_FIXED_CODE=
# Days of doses generated ahead.
DOSE_HORIZON_DAYS=7

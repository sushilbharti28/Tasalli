{
  "name": "@tasalli/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node -r @swc-node/register src/main.ts",
    "start": "node -r @swc-node/register src/main.ts",
    "migrate": "node -r @swc-node/register src/db/migrate-cli.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "tsc --noEmit -p tsconfig.json && eslint src test",
    "test": "jest --runInBand",
    "test:unit": "jest --runInBand --selectProjects unit",
    "test:api": "jest --runInBand --selectProjects api"
  },
  "dependencies": {
    "@nestjs/common": "10.4.15",
    "@nestjs/core": "10.4.15",
    "@nestjs/platform-express": "10.4.15",
    "@tasalli/contracts": "workspace:*",
    "bullmq": "5.34.6",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.1",
    "ioredis": "5.4.2",
    "libphonenumber-js": "1.11.17",
    "luxon": "3.5.0",
    "pg": "8.13.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1"
  },
  "devDependencies": {
    "@eslint/js": "9.17.0",
    "@nestjs/testing": "10.4.15",
    "@swc-node/register": "1.10.9",
    "@swc/core": "1.13.5",
    "@types/express": "5.0.0",
    "@types/jest": "29.5.14",
    "@types/luxon": "3.4.2",
    "@types/node": "22.10.2",
    "@types/pg": "8.11.10",
    "@types/supertest": "6.0.2",
    "eslint": "9.17.0",
    "jest": "29.7.0",
    "supertest": "7.0.0",
    "ts-jest": "29.2.5",
    "typescript": "5.7.2",
    "typescript-eslint": "8.18.2"
  }
}

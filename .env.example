# Tasalli environment variables.
# Copy to .env for local work: `cp .env.example .env`. Never commit .env.
# In AWS these come from Secrets Manager (secret names: tasalli/<env>/<NAME>),
# injected into ECS tasks as environment variables with the same names.
# Values below are safe local defaults or empty placeholders. No real keys here, ever.

# --- Runtime -------------------------------------------------------------
NODE_ENV=development
# dev | staging | prod. Also used as the Sentry environment.
APP_ENV=dev
LOG_LEVEL=info
# API listens here; call-engine listens on CALL_ENGINE_PORT.
PORT=3000
CALL_ENGINE_PORT=3001
# Public HTTPS base URL that providers call back on (webhooks) and that serves audio.
# Local: use a tunnel (e.g. cloudflared) when testing with a real provider.
PUBLIC_BASE_URL=http://localhost:3000

# --- Data stores (docker-compose.yml defaults) ----------------------------
DATABASE_URL=postgres://tasalli:tasalli@localhost:5432/tasalli
# Used only by tests; tests may create and drop this database.
TEST_DATABASE_URL=postgres://tasalli:tasalli@localhost:5432/tasalli_test
REDIS_URL=redis://localhost:6379

# --- Auth ------------------------------------------------------------------
# Long random string: `openssl rand -base64 48`
JWT_SECRET=change-me-local-only
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

# --- Telephony -------------------------------------------------------------
# fake | exotel | plivo. Unset or "fake" uses FakeProvider (no real calls).
TELEPHONY_PROVIDER=fake
# Approved, fixed caller ID shown to parents (E.164).
CALLER_ID=
EXOTEL_ACCOUNT_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
# e.g. api.in.exotel.com (Mumbai cluster)
EXOTEL_SUBDOMAIN=api.in.exotel.com
EXOTEL_APP_ID=
EXOTEL_WEBHOOK_SECRET=
# Twilio (the provider used for the pilot): TELEPHONY_PROVIDER=twilio. Fill these three, then run
# `pnpm --filter @tasalli/call-engine dev` or `... test-call +91XXXXXXXXXX`; both read this file.
# The call engine must be reachable from the internet (a tunnel in dev): set CALL_ENGINE_PUBLIC_BASE_URL to that
# https URL (PUBLIC_BASE_URL is the API's and is used only if it is not set). Twilio stores call recordings
# outside India by default (data-residency item for the pilot); set TWILIO_RECORD=false to turn recording off.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Hindi voice for calls. Try: Google.hi-IN-Chirp3-HD-Aoede, Google.hi-IN-Neural2-A, Polly.Kajal-Neural. Empty = Polly.Aditi.
TWILIO_VOICE=
CALL_ENGINE_PUBLIC_BASE_URL=
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
PLIVO_APP_ID=

# Shared secret that verifies billing (Razorpay) webhooks. Generate with `openssl rand -base64 32`; never commit a real value.
BILLING_WEBHOOK_SECRET=

# --- Speech ----------------------------------------------------------------
# fake | sarvam | google (decision pending, week 1)
SPEECH_PROVIDER=fake
SARVAM_API_KEY=
# Path to a Google service-account JSON file (never commit the file).
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_CLOUD_PROJECT=

# --- Audio storage (TTS cache and recordings) --------------------------------
AWS_REGION=ap-south-1
AUDIO_BUCKET=tasalli-dev-audio
# Optional: S3-compatible endpoint for local testing (e.g. MinIO). Empty in AWS.
S3_ENDPOINT=

# --- Messaging -------------------------------------------------------------
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=
MSG91_SENDER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# Firebase Cloud Messaging (service account fields)
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
# PEM with literal \n line breaks
FCM_PRIVATE_KEY=

# --- Payments --------------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_ONE_PARENT=
RAZORPAY_PLAN_TWO_PARENTS=
RAZORPAY_PLAN_FAMILY_YEARLY=

# --- Monitoring ------------------------------------------------------------
# Empty disables Sentry (local default).
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# --- Admin console (apps/admin) -------------------------------------------
ADMIN_API_BASE_URL=http://localhost:3000

{
  "name": "@tasalli/tests",
  "version": "0.1.0",
  "private": true,
  "description": "Cross-service scenario suites, speech test set, end-to-end API tests, load test and security checks for Tasalli.",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./scenarios": "./src/scenarios/index.ts",
    "./speech": "./src/speech/index.ts",
    "./harness": "./src/harness/index.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:e2e": "vitest run --dir e2e",
    "lint": "tsc --noEmit -p tsconfig.json",
    "load:scheduler": "tsx load/scheduler-load.ts"
  },
  "dependencies": {
    "@tasalli/contracts": "link:../packages/contracts"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}

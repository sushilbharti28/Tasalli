# Admin console configuration. Copy to .env.local and fill in. Never commit real values.

# Founder login
ADMIN_EMAIL=founder@example.com
# Either a plain password (local only) or a scrypt hash made with `pnpm --filter @tasalli/admin hash-password`
ADMIN_PASSWORD=
ADMIN_PASSWORD_HASH=
# At least 32 random characters; signs the session cookie
ADMIN_SESSION_SECRET=

# Postgres (Mumbai region). Reads use a read-only session on this URL.
DATABASE_URL=postgres://user:pass@localhost:5432/tasalli
# Optional separate URL for the few admin writes (block, pause, notes). Defaults to DATABASE_URL.
ADMIN_WRITE_DATABASE_URL=

# Tests only: a Postgres role that may create databases
# Optional: defaults to TEST_DATABASE_URL's server and user (or the docker-compose user tasalli)
TEST_DATABASE_ADMIN_URL=
